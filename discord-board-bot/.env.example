# Discord: https://discord.com/developers/applications -> your omoi app
DISCORD_TOKEN=
DISCORD_APP_ID=
# Guild to register /board in (guild commands show up instantly)
DISCORD_GUILD_ID=

# Optional: comma-separated role IDs allowed to use /board (empty = everyone)
BOARD_ALLOWED_ROLE_IDS=

# Plane: Profile settings -> Personal Access Tokens
PLANE_API_KEY=
# API base, e.g. https://api.plane.so or https://plane.example.com for self-hosted
PLANE_BASE_URL=https://api.plane.so
# Web UI base used for issue links (defaults to PLANE_BASE_URL; set to https://app.plane.so for cloud)
PLANE_WEB_URL=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
